# App
APP_NAME=HyTech Visa Copilot Backend
APP_ENV=development
SECRET_KEY=your-super-secret-key-change-this
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/hytech_visa
SYNC_DATABASE_URL=postgresql://postgres:password@localhost:5432/hytech_visa

# Redis
REDIS_URL=redis://localhost:6379/0

# Google OAuth & Drive Storage
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/google/callback
GOOGLE_SCOPES=https://www.googleapis.com/auth/calendar https://www.googleapis.com/auth/drive.file
FERNET_KEY=your-32-byte-base64-fernet-key
COUNSELOR_USER_ID=your-counselor-user-uuid

# OpenAI
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o

# Firebase (push notifications)
FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json

# Tesseract OCR
TESSERACT_CMD=/usr/bin/tesseract
