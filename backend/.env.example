# App
APP_NAME=HyTech Visa Copilot Backend
APP_ENV=development
SECRET_KEY=hytech-secret-key-12345-very-secure-random-token
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@127.0.0.1:5433/hytech_visa
SYNC_DATABASE_URL=postgresql://postgres:password@127.0.0.1:5433/hytech_visa

# Redis (skipped)
REDIS_URL=redis://localhost:6379/0

# AWS S3 (document storage)
AWS_ACCESS_KEY_ID=mock-aws-access-key
AWS_SECRET_ACCESS_KEY=mock-aws-secret-key
AWS_BUCKET_NAME=hytech-visa-documents
AWS_REGION=ap-south-1

# OpenAI (optional fallback)
OPENAI_API_KEY=sk-mock-key
OPENAI_MODEL=gpt-4o

# Groq API (Primary LLM service)
GROQ_API_KEY=gsk_
GROQ_API_BASE=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-specdec

# Firebase (push notifications)
FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json

# Tesseract OCR
TESSERACT_CMD=tesseract
