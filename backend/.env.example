# App
APP_NAME=HyTech Visa Copilot Backend
APP_ENV=development
SECRET_KEY=your-super-secret-key-change-this
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/hytech_visa
SYNC_DATABASE_URL=postgresql://postgres:password@localhost:5432/hytech_visa

# Redis
REDIS_URL=redis://localhost:6379/0

# AWS S3 (document storage)
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_BUCKET_NAME=hytech-visa-documents
AWS_REGION=ap-south-1

# OpenAI
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o

# Firebase (push notifications)
FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json

# Tesseract OCR
TESSERACT_CMD=/usr/bin/tesseract
